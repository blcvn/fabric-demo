{
    "info": {
      "name": "Hyperledger Fabric API Gateway",
      "description": "Collection for Hyperledger Fabric API Gateway",
      "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
      {
        "name": "Create Account",
        "request": {
          "method": "POST",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "url": {
            "raw": "http://localhost:8080/account/1001",
            "protocol": "http",
            "host": [
              "localhost"
            ],
            "port": "8080",
            "path": [
              "account",
              "1001"
            ]
          },
          "description": "Create a new account with the specified ID."
        }
      },
      {
        "name": "Add Balance",
        "request": {
          "method": "POST",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "url": {
            "raw": "http://localhost:8080/balance/add",
            "protocol": "http",
            "host": [
              "localhost"
            ],
            "port": "8080",
            "path": [
              "balance",
              "add"
            ]
          },
          "description": "Add balance to an account.",
          "body": {
            "mode": "raw",
            "raw": "{\n  \"account_id\": \"1001\",\n  \"amount\": 3000\n}"
          }
        }
      },
      {
        "name": "Deduct Balance",
        "request": {
          "method": "POST",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "url": {
            "raw": "http://localhost:8080/balance/deduct",
            "protocol": "http",
            "host": [
              "localhost"
            ],
            "port": "8080",
            "path": [
              "balance",
              "deduct"
            ]
          },
          "description": "Deduct balance from an account.",
          "body": {
            "mode": "raw",
            "raw": "{\n  \"account_id\": \"1001\",\n  \"amount\": 30\n}"
          }
        }
      },
      {
        "name": "Transfer to Multiple Accounts",
        "request": {
          "method": "POST",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "url": {
            "raw": "http://localhost:8080/transfer-multiple",
            "protocol": "http",
            "host": [
              "localhost"
            ],
            "port": "8080",
            "path": [
              "transfer-multiple"
            ]
          },
          "description": "Transfer funds from one account to multiple accounts.",
          "body": {
            "mode": "raw",
            "raw": "{\n  \"from_account\": \"1001\",\n  \"transfers\": {\n    \"1002\": 2000,\n    \"1003\": 2000\n  }\n}"
          }
        }
      },
      {
        "name": "Read Account",
        "request": {
          "method": "GET",
          "header": [],
          "url": {
            "raw": "http://localhost:8080/account/:id",
            "protocol": "http",
            "host": [
              "localhost"
            ],
            "port": "8080",
            "path": [
              "account",
              ":id"
            ]
          },
          "description": "Retrieve information about a specific account."
        }
      },
      {
        "name": "Get All Accounts",
        "request": {
          "method": "GET",
          "header": [],
          "url": {
            "raw": "http://localhost:8080/accounts",
            "protocol": "http",
            "host": [
              "localhost"
            ],
            "port": "8080",
            "path": [
              "accounts"
            ]
          },
          "description": "Retrieve a list of all accounts."
        }
      }
    ]
  }
  